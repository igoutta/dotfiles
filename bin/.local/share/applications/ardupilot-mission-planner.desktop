[Desktop Entry]
# Sustituye a la entrada del paquete AUR (mismo nombre; la de ~/.local/share/applications gana).
# Esa lanza mono directo sobre xwayland-satellite, donde los menús de WinForms no se dibujan;
# esta abre el script mission-planner de este paquete (Xwayland propio con openbox). La ventana
# es la de ese Xwayland, de ahí el StartupWMClass. Ubuntu/Fedora: igual, con el icono de la
# carpeta donde se descomprima Mission Planner.
Type=Application
Name=Mission Planner
GenericName=Ground Control Station
Comment=Mission Planner Ground Control Station
Exec=mission-planner
Icon=/opt/ardupilot-mission-planner/mpdesktop150.png
Terminal=false
StartupNotify=false
StartupWMClass=org.freedesktop.Xwayland
Categories=Utility;
Keywords=ardupilot;mission;planner;uav;
