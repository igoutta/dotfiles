# /etc/systemd/system/ghostmirror-deep.timer — el día 1 de cada mes a las 00:30; Persistent
# lo recupera si el equipo estaba apagado. Es el único que arranca el servicio.
[Unit]
Description=Run deep update every month at 00:30.

[Timer]
OnCalendar=*-*-01 00:30:00
Persistent=true

[Install]
WantedBy=timers.target
