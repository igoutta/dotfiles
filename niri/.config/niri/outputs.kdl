// Salidas. Declaradas aquí para que sobrevivan al reinicio; antes el giro del HDMI lo
// aplicaba en caliente el plugin niri-displays de noctalia y se perdía.
// Nombres y modos: niri msg outputs. Una salida que no esté conectada se ignora.

// Panel del portátil (ASUS TUF F15): 144 Hz. VRR solo cuando una ventana lo pide
// (juegos, vídeo a pantalla completa); con VRR permanente la barra parpadea al cambiar
// de frecuencia.
output "eDP-1" {
    mode "1920x1080@144.000"
    position x=0 y=0
    variable-refresh-rate on-demand=true
}

// ViewSonic VA1903 en vertical, a la derecha del portátil. "90" = 90° antihorario, que es
// lo que reporta niri msg outputs.
output "HDMI-A-1" {
    mode "1366x768@59.790"
    transform "90"
    position x=1920 y=0
}

// Tercer monitor, pendiente. Copiar y ajustar cuando esté conectado (niri msg outputs
// da el nombre exacto). Si llega por DisplayLink (evdi) comprobar antes que niri lo
// enumera: ese soporte no está verificado (TODO.md).
// output "DP-2" {
//     mode "1920x1080@60.000"
//     position x=-1920 y=0
// }
