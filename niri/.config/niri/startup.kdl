// Arranque, cursor, capturas y depuración.

// La shell (barra, lanzador, notificaciones, fondo, bloqueo). xwayland-satellite no hace
// falta lanzarlo: niri 26 lo arranca solo.
spawn-at-startup "noctalia"

// Agente de polkit: la ventana que pide la contraseña cuando una app gráfica necesita
// privilegios (sync del greeter, discos, actualizador). Noctalia no lo trae. Fedora:
// /usr/libexec/polkit-gnome-authentication-agent-1; Ubuntu: /usr/lib/policykit-1-gnome/….
spawn-at-startup "/usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1"

// El resumen de teclas (Mod+F1) no se muestra al iniciar sesión.
hotkey-overlay {
    skip-at-startup
}

// Capturas de niri (Print, Ctrl+Print, Alt+Print).
screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"

// Cursor Adwaita a 24 px: el mismo que declara el paquete gtk. environment lo exporta a
// las apps para que Xwayland y las que no leen gsettings usen el mismo.
cursor {
    xcursor-theme "Adwaita"
    xcursor-size 24
}

// QT_QPA_PLATFORMTHEME: las apps Qt leen qt6ct (paquete stow qt/), que toma la paleta de
// noctalia. Llega a lo que lanza niri, noctalia incluido; lo abierto antes lo ve al volver a entrar.
environment {
    XCURSOR_THEME "Adwaita"
    XCURSOR_SIZE "24"
    QT_QPA_PLATFORMTHEME "qt6ct"
}

// Algunas apps (noctalia entre ellas) piden el foco con un serial de activación no válido;
// sin esto niri lo ignora y la ventana no sube.
debug {
    honor-xdg-activation-with-invalid-serial
    // Desde el 2026-09-30 niri dibuja en la NVIDIA: con el render en la Intel, el ViewSonic por
    // USB-C (cableado a la NVIDIA) a su nativa 1366x768 salía como basura (outputs.kdl). Precio:
    // la NVIDIA ya no se duerme y las apps pintan en ella; medido con los tres fondos de vídeo,
    // 15 W y 2,4 GB de memoria de vídeo frente a 4 W y 27 MB. Necesita el perfil
    // etc/nvidia/nvidia-application-profiles-rc.d/ (memoria de vídeo, wiki de niri). Por ruta
    // PCI. Se lee al entrar en la sesión, no al recargar la config.
    // Volver a la Intel (o si la sesión no arranca: Ctrl+Alt+F3, entrar), y luego el ViewSonic
    // a 1280x720 en outputs.kdl:
    //   sed -i '/pci-0000:01:00.0-render/d; s|^    // render-drm-device|    render-drm-device|' ~/dotfiles/niri/.config/niri/startup.kdl
    render-drm-device "/dev/dri/by-path/pci-0000:01:00.0-render"
    // En la Intel (la NVIDIA solo atiende el USB-C y lo lanzado con prime-run):
    // render-drm-device "/dev/dri/by-path/pci-0000:00:02.0-render"
}
