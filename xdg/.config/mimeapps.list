# ~/.config/mimeapps.list — qué app abre cada tipo de archivo (xdg-open, gio, navegadores).
# Imágenes en PhotoQt; carpetas en yazi (yazi.desktop del paquete: Terminal=true, que GLib abre
# en ghostty con xdg-terminal-exec y xdg-terminals.list, en este mismo paquete; xdg-open no: fuera
# de GNOME/KDE ignora Terminal=true y yazi muere sin terminal, así que para abrir una carpeta
# desde un programa, gio open — el panel de USB y el de OneDrive ya lo usan); html y enlaces
# en Zen; PDF en el Editor de PDF4QT (el LaunchPad también se anuncia para PDF y en 1.6.0 no abre
# nada); modelos STL y STEP en f3d; texto en Helix por defecto del sistema. xdg-open necesita
# perl-file-mimeinfo para ver model/step y model/stl (INSTALL).
# Mismo archivo en Ubuntu/Fedora (con el Flatpak de PDF4QT, comprobar el nombre del .desktop en
# /var/lib/flatpak/exports/share/applications). Cambiar en caliente: xdg-mime default <app.desktop> <tipo>.

[Added Associations]
application/x-desktop=com.mitchellh.ghostty.desktop;io.github.nokse22.Exhibit.desktop;Helix.desktop;micro.desktop;nvim.desktop;
application/x-extension-htm=zen.desktop;
application/x-extension-html=zen.desktop;
application/x-extension-shtml=zen.desktop;
application/x-extension-xht=zen.desktop;
application/x-extension-xhtml=zen.desktop;
application/xhtml+xml=zen.desktop;
text/html=zen.desktop;
x-scheme-handler/chrome=zen.desktop;
x-scheme-handler/http=zen.desktop;
x-scheme-handler/https=zen.desktop;

[Default Applications]
application/x-desktop=com.mitchellh.ghostty.desktop;
application/x-extension-htm=zen.desktop
application/x-extension-html=zen.desktop
application/x-extension-shtml=zen.desktop
application/x-extension-xht=zen.desktop
application/x-extension-xhtml=zen.desktop
application/xhtml+xml=zen.desktop
text/html=zen.desktop
x-scheme-handler/about=vivaldi-stable.desktop
x-scheme-handler/chrome=zen.desktop
x-scheme-handler/http=zen.desktop
x-scheme-handler/https=zen.desktop
x-scheme-handler/unknown=vivaldi-stable.desktop
inode/directory=yazi.desktop
image/png=org.photoqt.PhotoQt.desktop
image/jpeg=org.photoqt.PhotoQt.desktop
image/webp=org.photoqt.PhotoQt.desktop
image/gif=org.photoqt.PhotoQt.desktop
image/avif=org.photoqt.PhotoQt.desktop
image/bmp=org.photoqt.PhotoQt.desktop
image/tiff=org.photoqt.PhotoQt.desktop
image/svg+xml=org.photoqt.PhotoQt.desktop
application/pdf=io.github.JakubMelka.Pdf4qt.Pdf4QtEditor.desktop
model/stl=f3d.desktop
model/step=f3d.desktop
application/vnd.step=f3d.desktop
# Enlaces claude-cli:// (botones de la web de Claude que abren una sesión en Claude Code): la
# línea y ~/.local/share/applications/claude-code-url-handler.desktop las escribe Claude Code al
# arrancar; ese .desktop no está en el repo. Si no estuviera aquí, el archivo saldría modificado.
x-scheme-handler/claude-cli=claude-code-url-handler.desktop
