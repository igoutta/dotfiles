# ~/.config/mimeapps.list — qué app abre cada tipo de archivo (xdg-open, gio, navegadores).
# Imágenes en PhotoQt; carpetas en yazi dentro de ghostty (yazi-ghostty.desktop, en este mismo
# paquete); html y enlaces en Zen; texto en Helix por defecto del sistema. Mismo archivo en
# Ubuntu/Fedora. Cambiar en caliente: xdg-mime default <app.desktop> <tipo>.

[Added Associations]
application/x-desktop=com.mitchellh.ghostty.desktop;io.github.nokse22.Exhibit.desktop;Helix.desktop;micro.desktop;nvim.desktop;
application/x-extension-htm=zen.desktop;
application/x-extension-html=zen.desktop;
application/x-extension-shtml=zen.desktop;
application/x-extension-xht=zen.desktop;
application/x-extension-xhtml=zen.desktop;
application/xhtml+xml=zen.desktop;
text/html=zen.desktop;
x-scheme-handler/chrome=zen.desktop;
x-scheme-handler/http=zen.desktop;
x-scheme-handler/https=zen.desktop;

[Default Applications]
application/x-desktop=com.mitchellh.ghostty.desktop;
application/x-extension-htm=zen.desktop
application/x-extension-html=zen.desktop
application/x-extension-shtml=zen.desktop
application/x-extension-xht=zen.desktop
application/x-extension-xhtml=zen.desktop
application/xhtml+xml=zen.desktop
text/html=zen.desktop
x-scheme-handler/about=vivaldi-stable.desktop
x-scheme-handler/chrome=zen.desktop
x-scheme-handler/http=zen.desktop
x-scheme-handler/https=zen.desktop
x-scheme-handler/unknown=vivaldi-stable.desktop
inode/directory=yazi-ghostty.desktop
image/png=org.photoqt.PhotoQt.desktop
image/jpeg=org.photoqt.PhotoQt.desktop
image/webp=org.photoqt.PhotoQt.desktop
image/gif=org.photoqt.PhotoQt.desktop
image/avif=org.photoqt.PhotoQt.desktop
image/bmp=org.photoqt.PhotoQt.desktop
image/tiff=org.photoqt.PhotoQt.desktop
image/svg+xml=org.photoqt.PhotoQt.desktop
